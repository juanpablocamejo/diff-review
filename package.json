{
  "name": "diff-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local UI to prompt a coding agent for a branch review and browse the result.",
  "scripts": {
    "test": "node --test lib/*.test.mjs",
    "web:install": "bun --cwd web install",
    "web:dev": "bun --cwd web run dev",
    "web:build": "bun --cwd web run build",
    "web:check": "bun --cwd web run type-check"
  },
  "engines": {
    "node": ">=20"
  }
}
