{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juanpablocamejo/diff-review/schemas/review-document.json",
  "title": "Diff Review Document",
  "description": "JSON que escribe el agente (intent/groups/blocks/findings/skipped). La UI completa files con git al abrir el reporte; no hace falta que el modelo incluya diffs.",
  "type": "object",
  "required": ["intent", "groups", "blocks", "findings"],
  "properties": {
    "intent": {
      "type": "string",
      "description": "Intención general del diff en 2-4 oraciones: qué problema resuelve, no qué archivos toca."
    },

    "groups": {
      "type": "array",
      "minItems": 1,
      "description": "Temas del diff. El orden refleja dependencias: si g2 usa lo que introduce g1, g1 va antes.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "intent"],
        "properties": {
          "id": { "type": "string", "pattern": "^g[0-9]+$" },
          "kind": {
            "type": "string",
            "enum": ["feat", "fix", "refactor", "perf", "test", "chore", "docs", "infra"]
          },
          "title": {
            "type": "string",
            "maxLength": 72,
            "description": "Resumen del tema en una línea sin repetir kind (el chip ya lo muestra), ej. 'warehouses: CRUD de depósitos locales' o 'product: alta de depósitos'."
          },
          "intent": { "type": "string", "maxLength": 240, "description": "Por qué existe este tema." }
        }
      }
    },

    "blocks": {
      "type": "array",
      "minItems": 1,
      "description": "Diccionario de tramos. Un bloque puede abarcar varios hunks contiguos del mismo archivo con el mismo motivo.",
      "items": {
        "type": "object",
        "required": ["id", "group", "file", "lines", "op", "what"],
        "properties": {
          "id": { "type": "string", "pattern": "^b[0-9]+$" },
          "group": { "type": "string", "pattern": "^g[0-9]+$" },
          "file": { "type": "string", "description": "Path relativo exacto del archivo en el diff." },
          "lines": {
            "type": "string",
            "description": "Rango post-imagen: 'L40-58' o 'L40'. Con guion adelante si es pre-imagen (borrado): '-L88-95'."
          },
          "side": { "type": "string", "enum": ["new", "old"] },
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 },
          "op": { "type": "string", "enum": ["add", "mod", "del", "rename"] },
          "what": {
            "type": "string",
            "maxLength": 200,
            "description": "Qué cambia este bloque."
          },
          "why": {
            "type": "string",
            "maxLength": 200,
            "description": "Por qué. Vacío solo si no es inferible."
          },
          "source": {
            "type": "string",
            "enum": ["code", "commit", "pr", "issue", "inferred"]
          }
        }
      }
    },

    "findings": {
      "type": "array",
      "description": "class=risk son riesgos de merge; class=quality son mejoras de calidad.",
      "items": {
        "type": "object",
        "required": ["id", "class", "severity", "blocking", "kind", "file", "what", "fix"],
        "properties": {
          "id": { "type": "string", "pattern": "^f[0-9]+$" },
          "class": { "type": "string", "enum": ["risk", "quality"] },
          "severity": { "type": "string", "enum": ["high", "med", "low", "nit"] },
          "blocking": {
            "type": "boolean",
            "description": "true = no debería mergearse así. Solo con class=risk."
          },
          "kind": {
            "type": "string",
            "enum": ["bug", "race", "auth", "security", "api-break", "missing-test", "perf", "maintainability", "docs", "other"]
          },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"], "description": "Línea de la post-imagen (columna derecha / @@ +N)." },
          "block": { "type": ["string", "null"], "description": "Id del bloque, o vacío/null si es transversal." },
          "what": { "type": "string", "maxLength": 300 },
          "fix": { "type": "string", "maxLength": 300, "description": "Acción concreta." }
        }
      }
    },

    "skipped": {
      "type": "array",
      "description": "Archivos del diff que no se explican, con motivo (o glob).",
      "items": {
        "type": "object",
        "required": ["file", "reason"],
        "properties": {
          "file": { "type": "string" },
          "reason": {
            "type": "string",
            "enum": ["generated", "lockfile", "format", "vendored", "binary", "trivial", "ignored"]
          }
        }
      }
    },

    "files": {
      "type": "array",
      "description": "Diffs para renderizar. Los llena la UI con git; el agente no los incluye.",
      "items": {
        "type": "object",
        "required": ["path", "changeType", "diff"],
        "properties": {
          "path": { "type": "string" },
          "oldPath": { "type": "string" },
          "changeType": { "type": "string", "enum": ["added", "modified", "deleted", "renamed"] },
          "diff": { "type": "string" },
          "group": { "type": "string" }
        }
      }
    },

    "notes": {
      "type": "array",
      "description": "Avisos breves sobre limitaciones de la review, si aplica.",
      "items": { "type": "string" }
    }
  }
}
